<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Minha Carteira | Terminal Radar</title>
    <link rel="stylesheet" href="/css/style_global.css">
    <link rel="stylesheet" href="/css/style_index.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Roboto+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .row-master { cursor: pointer; border-bottom: 1px solid var(--border); }
        .row-master:hover { background: rgba(59, 130, 246, 0.05) !important; }
        .row-details { display: none; background: #0b0e11; }
        .details-container { padding: 15px; border-left: 3px solid var(--accent-blue); margin: 5px 20px; border-radius: 4px; }
        .sub-table { width: 100%; font-size: 11px; border-collapse: collapse; }
        .sub-table th { color: var(--text-secondary); text-align: left; padding: 5px; border-bottom: 1px solid var(--border); }
        .sub-table td { padding: 8px 5px; border-bottom: 1px solid #1a1f26; }
        .btn-mini-action { background: var(--bg-navbar); color: var(--text-primary); border: 1px solid var(--border); padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 11px; transition: 0.2s; }
        .btn-mini-action:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
        .btn-delete-all { background: transparent; color: var(--accent-red); border: 1px solid transparent; padding: 5px 10px; border-radius: 4px; cursor: pointer; transition: 0.2s; }
        .btn-delete-all:hover { border-color: var(--accent-red); background: rgba(246, 70, 93, 0.1); }
        .badge-compra { color: var(--accent-green); font-weight: bold; }
        .badge-venda { color: var(--accent-red); font-weight: bold; }
        .trend-positive { color: #0ecb81 !important; }
        .trend-negative { color: #f6465d !important; }
        .summary-card { background: var(--bg-card); padding: 20px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 25px; display: flex; gap: 40px; }
        .summary-item { display: flex; flex-direction: column; }
        .summary-label { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; margin-bottom: 5px; }
        .summary-value { font-size: 22px; font-weight: 800; font-family: 'Roboto Mono', monospace; }
        .type-selector { display: flex; gap: 10px; margin-bottom: 20px; }
        .type-btn { flex: 1; padding: 12px; border: 1px solid var(--border); background: var(--bg-main); color: var(--text-secondary); cursor: pointer; border-radius: 6px; font-weight: bold; text-align: center; font-size: 12px; }
        .type-btn.active-compra { border-color: var(--accent-green); color: var(--accent-green); background: rgba(14, 203, 129, 0.1); }
        .type-btn.active-venda { border-color: var(--accent-red); color: var(--accent-red); background: rgba(246, 70, 93, 0.1); }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div style="padding: 22px 20px; color: var(--accent-blue); border-bottom: 1px solid var(--border); margin-bottom: 10px;">
             <i class="fa-solid fa-wave-square fa-xl"></i>
        </div>
        <a href="/" class="nav-item"><i class="fa-solid fa-chart-line"></i><span class="nav-text">Radar de Mercado</span></a>
        <a href="/watchlist" class="nav-item" style="color: var(--accent-blue); background: var(--bg-card);"><i class="fa-solid fa-wallet"></i><span class="nav-text">Minha Carteira</span></a>
    </nav>

    <div class="main-layout">
        <nav class="navbar">
            <div class="logo-container">
                <svg class="logo-icon" viewBox="0 0 24 24"><path d="M3.5,18.5L9.5,12.5L13.5,16.5L22,6.92L20.59,5.5L13.5,13.5L9.5,9.5L2,17L3.5,18.5Z" /></svg>
                <span class="logo-text">TERMINAL<span style="color:var(--accent-blue)">RADAR</span></span>
            </div>
            <div class="market-status">
                <% const agora = new Date(); const estaAberto = (agora.getDay() >= 1 && agora.getDay() <= 5 && agora.getHours() >= 10 && agora.getHours() < 18); %>
                <div class="status-dot <%= estaAberto ? 'dot-open' : 'dot-closed' %>"></div>
                <span>B3: <%= estaAberto ? 'OPEN' : 'CLOSED' %></span>
            </div>
            <button class="btn-search-styled" onclick="toggleModal(true)">
                <i class="fa-solid fa-plus" style="margin-right: 8px;"></i> NOVA OPERAÇÃO
            </button>
        </nav>

        <div class="container">
            <div class="dashboard-header">
                <div><h2 style="margin:0;">Patrimônio Atualizado</h2><p style="color:var(--text-secondary); font-size:11px;">Controle de custódia e histórico de lote.</p></div>
            </div>

            <div class="summary-card">
                <div class="summary-item">
                    <span class="summary-label">Total Investido</span>
                    <span class="summary-value" id="totalInvestido" style="color: var(--text-secondary);">R$ 0,00</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Valor de Mercado</span>
                    <span class="summary-value" id="patrimonioTotal">R$ 0,00</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Resultado Geral</span>
                    <span class="summary-value" id="resultadoGeral">R$ 0,00</span>
                </div>
            </div>

            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 30px;"></th>
                            <th>Ticker</th>
                            <th style="text-align:right">Saldo</th>
                            <th style="text-align:right">P. Médio</th>
                            <th style="text-align:right">P. Atual</th>
                            <th style="text-align:right">Valor Atual</th>
                            <th style="text-align:right">Diferença Total</th>
                            <th style="text-align:right">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="watchlistBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalAdd">
        <div class="modal-content">
            <div class="modal-header"><h3>Registrar Operação</h3><button class="close-modal" onclick="toggleModal(false)">&times;</button></div>
            
            <div class="type-selector">
                <div id="btnTypeCompra" class="type-btn active-compra" onclick="setType('C')">COMPRA</div>
                <div id="btnTypeVenda" class="type-btn" onclick="setType('V')">VENDA</div>
            </div>
            <input type="hidden" id="inType" value="C">

            <div class="form-group">
                <label>Data</label>
                <input type="date" id="inData" class="form-control" onchange="validarData(this); fetchHistoricalPrice()">
                <small id="dateError" style="color:var(--accent-red); display:none; font-size:10px;">Fins de semana bloqueados.</small>
            </div>
            <div class="form-group">
                <label>Ativo</label>
                <input type="text" id="inTicker" class="form-control" placeholder="PETR4" list="l-ativos" oninput="fetchHistoricalPrice()">
                <datalist id="l-ativos"><% listaGlobal.forEach(a => { %> <option value="<%= a.t %>"><%= a.n %></option> <% }) %></datalist>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div class="form-group"><label>Quantidade</label><input type="number" id="inQtd" class="form-control"></div>
                <div class="form-group">
                    <label id="lblPreco">Preço Pago</label>
                    <div style="position: relative;">
                        <input type="number" step="0.01" id="inPM" class="form-control">
                        <small id="priceLoader" style="position: absolute; right: 10px; top: 10px; display: none; color: var(--accent-blue);">Busca...</small>
                    </div>
                </div>
            </div>
            <button class="btn-block" id="btnSalvar" onclick="saveAndClose()">SALVAR OPERAÇÃO</button>
        </div>
    </div>

    <script>
        let currentType = 'C';

        function setType(type) {
            currentType = type;
            document.getElementById('inType').value = type;
            document.getElementById('btnTypeCompra').className = type === 'C' ? 'type-btn active-compra' : 'type-btn';
            document.getElementById('btnTypeVenda').className = type === 'V' ? 'type-btn active-venda' : 'type-btn';
            document.getElementById('lblPreco').innerText = type === 'C' ? 'Preço Pago' : 'Preço de Venda';
        }

        function toggleModal(show, prefilledTicker = '') {
            const modal = document.getElementById('modalAdd');
            const inputData = document.getElementById('inData');
            modal.style.display = show ? 'flex' : 'none';
            if(show) {
                const hoje = new Date();
                inputData.value = hoje.toISOString().split('T')[0];
                document.getElementById('inTicker').value = prefilledTicker;
                document.getElementById('inQtd').value = '';
                document.getElementById('inPM').value = '';
                setType('C');
                validarData(inputData);
                if(prefilledTicker) fetchHistoricalPrice();
            }
        }

        function validarData(input) {
            const d = new Date(input.value + 'T00:00:00').getDay();
            const btn = document.getElementById('btnSalvar');
            if(d === 0 || d === 6) { btn.disabled=true; btn.style.opacity='0.5'; }
            else { btn.disabled=false; btn.style.opacity='1'; }
        }

        async function fetchHistoricalPrice() {
            const t = document.getElementById('inTicker').value.toUpperCase();
            const d = document.getElementById('inData').value;
            if (t.length >= 4 && d) {
                document.getElementById('priceLoader').style.display = 'block';
                try {
                    const res = await fetch(`/api/preco-historico?ticker=${t}&data=${d}`);
                    const data = await res.json();
                    if(data.preco > 0) document.getElementById('inPM').value = data.preco;
                } catch(e) {}
                document.getElementById('priceLoader').style.display = 'none';
            }
        }

        async function renderWatchlist() {
            const rawData = JSON.parse(localStorage.getItem('myPortfolio') || '[]');
            const body = document.getElementById('watchlistBody');
            if (rawData.length === 0) {
                body.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:40px; color:var(--text-secondary);">Sua carteira está vazia.</td></tr>';
                atualizarSumario(0, 0);
                return;
            }

            const consolidado = {};
            rawData.sort((a,b) => new Date(a.data) - new Date(b.data)).forEach(item => {
                if (!consolidado[item.ticker]) consolidado[item.ticker] = { ticker: item.ticker, saldoQtd: 0, precoMedio: 0, hist: [] };
                const q = parseInt(item.qtd);
                const p = parseFloat(item.pm);
                const a = consolidado[item.ticker];
                if (item.type === 'V') {
                    a.saldoQtd -= q;
                } else {
                    const totalAnterior = a.saldoQtd * a.precoMedio;
                    const totalNovo = q * p;
                    a.saldoQtd += q;
                    a.precoMedio = (totalAnterior + totalNovo) / a.saldoQtd;
                }
                a.hist.push(item);
            });

            let html = '';
            let totalInvestidoGlobal = 0;
            let patrimonioTotalGlobal = 0;

            for (const key in consolidado) {
                const a = consolidado[key];
                const res = await fetch(`/api/preco/${a.ticker}`);
                const data = await res.json();
                const pAtual = parseFloat(data.preco);
                
                const valorAtualAtivo = a.saldoQtd * pAtual;
                const custoAtivo = a.saldoQtd * a.precoMedio;
                const diff = valorAtualAtivo - custoAtivo;
                const perc = a.precoMedio > 0 ? ((pAtual / a.precoMedio) - 1) * 100 : 0;
                const cClass = diff >= 0 ? 'trend-positive' : 'trend-negative';

                totalInvestidoGlobal += custoAtivo;
                patrimonioTotalGlobal += valorAtualAtivo;

                html += `
                    <tr class="row-master" onclick="toggleDetails('${a.ticker}')">
                        <td style="text-align:center;"><i class="fa-solid fa-chevron-down" id="icon-${a.ticker}"></i></td>
                        <td style="font-weight:bold">${a.ticker}</td>
                        <td style="text-align:right">${a.saldoQtd}</td>
                        <td style="text-align:right" class="price-mono">R$ ${a.precoMedio.toFixed(2)}</td>
                        <td style="text-align:right" class="price-mono">R$ ${pAtual.toFixed(2)}</td>
                        <td style="text-align:right" class="price-mono">R$ ${valorAtualAtivo.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</td>
                        <td style="text-align:right" class="price-mono ${cClass}">R$ ${diff.toFixed(2)} (${perc.toFixed(2)}%)</td>
                        <td style="text-align:right; display: flex; gap: 5px; justify-content: flex-end;">
                            <button class="btn-mini-action" onclick="event.stopPropagation(); toggleModal(true, '${a.ticker}')">
                                <i class="fa-solid fa-plus-minus"></i>
                            </button>
                            <button class="btn-delete-all" onclick="event.stopPropagation(); removeTickerGroup('${a.ticker}')" title="Apagar lote inteiro">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                    <tr class="row-details" id="details-${a.ticker}">
                        <td colspan="8"><div class="details-container"><table class="sub-table"><thead><tr><th>Operação</th><th>Data</th><th>Qtd</th><th>Preço</th><th>Ação</th></tr></thead><tbody>
                        ${a.hist.reverse().map(h => `
                            <tr>
                                <td class="${h.type === 'V' ? 'badge-venda' : 'badge-compra'}">${h.type === 'V' ? 'VENDA' : 'COMPRA'}</td>
                                <td>${h.data.split('-').reverse().join('/')}</td>
                                <td>${h.qtd}</td>
                                <td>R$ ${parseFloat(h.pm).toFixed(2)}</td>
                                <td><button onclick="removeItem('${h.id}')" style="background:none; border:none; color:var(--accent-red); cursor:pointer"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>`).join('')}
                        </tbody></table></div></td></tr>`;
            }
            body.innerHTML = html;
            atualizarSumario(totalInvestidoGlobal, patrimonioTotalGlobal);
        }

        function atualizarSumario(investido, patrimonio) {
            const resGeral = patrimonio - investido;
            document.getElementById('totalInvestido').innerText = `R$ ${investido.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('patrimonioTotal').innerText = `R$ ${patrimonio.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('resultadoGeral').innerText = `R$ ${resGeral.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('resultadoGeral').className = `summary-value ${resGeral >= 0 ? 'trend-positive' : 'trend-negative'}`;
        }

        function removeTickerGroup(ticker) {
            if(confirm(`Deseja apagar TODO o histórico e o lote de ${ticker}? Esta ação não pode ser desfeita.`)) {
                let list = JSON.parse(localStorage.getItem('myPortfolio') || '[]');
                list = list.filter(item => item.ticker !== ticker);
                localStorage.setItem('myPortfolio', JSON.stringify(list));
                renderWatchlist();
            }
        }

        function toggleDetails(ticker) {
            const el = document.getElementById(`details-${ticker}`);
            const icon = document.getElementById(`icon-${ticker}`);
            const isVisible = el.style.display === 'table-row';
            el.style.display = isVisible ? 'none' : 'table-row';
            icon.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(180deg)';
        }

        function saveAndClose() {
            const d = document.getElementById('inData').value;
            const t = document.getElementById('inTicker').value.toUpperCase();
            const q = document.getElementById('inQtd').value;
            const p = document.getElementById('inPM').value;
            const type = document.getElementById('inType').value;
            if(!d || !t || !q || !p) return;
            let list = JSON.parse(localStorage.getItem('myPortfolio') || '[]');
            list.push({ id: Date.now().toString(), data: d, ticker: t, qtd: q, pm: p, type: type });
            localStorage.setItem('myPortfolio', JSON.stringify(list));
            toggleModal(false); renderWatchlist();
        }

        function removeItem(id) {
            event.stopPropagation();
            if(confirm("Remover esta operação específica?")) {
                let list = JSON.parse(localStorage.getItem('myPortfolio') || '[]');
                list = list.filter(i => i.id !== id);
                localStorage.setItem('myPortfolio', JSON.stringify(list));
                renderWatchlist();
            }
        }
        document.addEventListener('DOMContentLoaded', renderWatchlist);
    </script>
</body>
</html>